<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:App.Avalonia" xmlns:c="using:Contracts" x:Class="App.Avalonia.MainWindow" x:DataType="local:MainViewModel" Width="1600" Height="950" MinWidth="1280" MinHeight="800" Title="Wafer Sequence Simulator" Background="#0C1520">
  <Window.Styles>
    <Style Selector="Border.card"><Setter Property="Background" Value="#172638"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12"/></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="#91A8BC"/><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="TextBlock.value"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="92,*" Margin="12" RowSpacing="10">
    <Border Classes="card" Grid.Row="0"><Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="12">
      <StackPanel Grid.Column="0"><TextBlock Classes="caption" Text="장비 상태"/><Border Background="{Binding StateBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"><TextBlock Classes="value" Text="{Binding StateText}"/></Border></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Classes="caption" Text="시뮬레이션 시간"/><TextBlock Classes="value" Text="{Binding SimTime}"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Classes="caption" Text="평균 Tact"/><TextBlock Classes="value" Text="{Binding AverageTact}"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Classes="caption" Text="UPH"/><TextBlock Classes="value" Text="{Binding Uph}"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Classes="caption" Text="완료 / 전체"/><TextBlock Classes="value" Text="{Binding WaferProgress}"/></StackPanel>
      <StackPanel Grid.Column="5"><TextBlock Classes="caption" Text="저장 큐"/><TextBlock Classes="value" Text="{Binding QueueText}"/><ProgressBar Value="{Binding QueueFraction}" Maximum="1" Height="5"/></StackPanel>
      <StackPanel Grid.Column="6"><TextBlock Classes="caption" Text="활성 알람"/><TextBlock Classes="value" Text="{Binding AlarmCount}"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Row="1" ColumnDefinitions="315,*,430" ColumnSpacing="10">
      <Border Classes="card" Grid.Column="0"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <TextBlock FontSize="17" FontWeight="Bold" Text="레시피 · 조작"/>
        <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding RecipeGroups}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:RecipeGroup"><StackPanel Spacing="7" Margin="0,0,0,16"><TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#64B5D9" FontSize="14"/><ItemsControl ItemsSource="{Binding TextFields}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:RecipeField"><StackPanel Margin="0,0,0,5"><TextBlock Classes="caption" Text="{Binding Label}"/><TextBox Text="{Binding Value, Mode=TwoWay}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding ChoiceFields}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:RecipeField"><StackPanel Margin="0,0,0,5"><TextBlock Classes="caption" Text="{Binding Label}"/><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Mode=TwoWay}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding BooleanFields}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:RecipeField"><CheckBox Content="{Binding Label}" IsChecked="{Binding BoolValue, Mode=TwoWay}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="7"><TextBlock Classes="caption" Text="CustomSites: XUm,YUm; XUm,YUm"/><StackPanel Orientation="Horizontal" Spacing="5"><Button Content="저장" Command="{Binding SaveRecipeCommand}"/><Button Content="불러오기" Command="{Binding LoadRecipeCommand}"/></StackPanel><TextBlock Text="웨이퍼 수"/><NumericUpDown Minimum="1" Maximum="25" Value="{Binding WaferCount, Mode=TwoWay}"/><WrapPanel Orientation="Horizontal"><Button Content="초기화" Command="{Binding InitializeCommand}" IsEnabled="{Binding CanInitialize}"/><Button Content="시작" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/><Button Content="일시정지" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}"/><Button Content="재개" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}"/><Button Content="중단" Command="{Binding AbortCommand}" IsEnabled="{Binding CanAbort}"/><Button Content="리셋" Command="{Binding ResetCommand}" IsEnabled="{Binding CanReset}"/></WrapPanel><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#F6C96C"/></StackPanel>
      </Grid></Border>
      <Grid Grid.Column="1" RowDefinitions="*,390" RowSpacing="10">
        <Border Classes="card"><Grid RowDefinitions="Auto,*"><TextBlock FontSize="16" FontWeight="Bold" Text="장비 평면 · 측면"/><local:EquipmentView Grid.Row="1" Snapshot="{Binding Snapshot}"/></Grid></Border>
        <Border Classes="card" Grid.Row="1"><Grid RowDefinitions="Auto,*" RowSpacing="8"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock FontSize="16" FontWeight="Bold" Text="모듈 타임라인"/><TextBlock VerticalAlignment="Center" Text="최근 초"/><Slider Width="150" Minimum="10" Maximum="300" Value="{Binding WindowSeconds, Mode=TwoWay}"/><TextBlock Text="{Binding WindowSeconds, StringFormat='{}{0:F0}s'}"/></StackPanel><local:GanttView Grid.Row="1" Snapshot="{Binding Snapshot}" Steps="{Binding Logs}" WindowSeconds="{Binding WindowSeconds}"/></Grid></Border>
      </Grid>
      <Border Classes="card" Grid.Column="2"><TabControl>
        <TabItem Header="로그"><Grid RowDefinitions="Auto,*"><CheckBox Content="대기만" IsChecked="{Binding WaitsOnly}"/><ListBox Grid.Row="1" ItemsSource="{Binding VisibleLogs}" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate x:DataType="c:StepEvent"><StackPanel Margin="0,2"><Grid ColumnDefinitions="36,74,36,28,53,72,*" ColumnSpacing="2"><TextBlock Grid.Column="0" Text="{Binding Seq}"/><TextBlock Grid.Column="1" Text="{Binding Start, StringFormat='{}{0:mm\:ss\.fff}'}" FontSize="10"/><TextBlock Grid.Column="2" Text="{Binding WaferId}"/><TextBlock Grid.Column="3" Text="{Binding SiteIndex}"/><TextBlock Grid.Column="4" Text="{Binding Module}" FontSize="10"/><TextBlock Grid.Column="5" Text="{Binding Phase}" FontSize="10"/><TextBlock Grid.Column="6" Text="{Binding Duration, StringFormat='{}{0:mm\:ss\.fff}'}" FontSize="10"/></Grid><TextBlock Text="{Binding WaitReason}" TextWrapping="Wrap" Foreground="#AFC3D1" FontSize="10"/><TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#AFC3D1" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
        <TabItem Header="웨이퍼 맵"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="8"><ComboBox ItemsSource="{Binding Summaries}" SelectedItem="{Binding SelectedSummary, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="c:WaferSummary"><TextBlock Text="{Binding WaferId}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><local:WaferMapView Grid.Row="1" Summary="{Binding SelectedSummary}"/><StackPanel Grid.Row="2" DataContext="{Binding SelectedSummary}" x:DataType="c:WaferSummary"><TextBlock Text="{Binding MeanRs, StringFormat='평균 {0:F3} Ω/sq'}"/><TextBlock Text="{Binding SigmaRs, StringFormat='σ {0:F3}'}"/><TextBlock Text="{Binding UniformitySigmaPct, StringFormat='균일도 σ {0:F2}%'}"/><TextBlock Text="{Binding UniformityRangePct, StringFormat='균일도 범위 {0:F2}%'}"/><TextBlock Text="{Binding RepeatabilityPct, StringFormat='재현성 {0:F2}%'}"/><TextBlock Text="{Binding Tact, StringFormat='Tact {0:mm\:ss\.fff}'}"/><TextBlock Text="{Binding MinRs, StringFormat='범례 최소 {0:F3}'}"/><TextBlock Text="{Binding MaxRs, StringFormat='범례 최대 {0:F3}'}"/></StackPanel></Grid></TabItem>
        <TabItem Header="통계"><ScrollViewer><StackPanel Spacing="10"><TextBlock Text="{Binding WaitRatio}"/><ItemsControl ItemsSource="{Binding Phases}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:PhaseBar"><Grid ColumnDefinitions="110,*,65" Margin="0,3"><TextBlock Text="{Binding Phase}"/><ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent}"/><TextBlock Grid.Column="2" Text="{Binding Seconds, StringFormat='{}{0:F1}s'}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="두 실행 비교" FontWeight="Bold"/><ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRunA, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="c:RunRecord"><TextBlock Text="{Binding RunId}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRunB, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="c:RunRecord"><TextBlock Text="{Binding RunId}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="비교" Command="{Binding CompareCommand}"/><TextBlock Text="{Binding ComparisonText}"/><ItemsControl ItemsSource="{Binding PhaseDeltas}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="c:PhaseDelta"><Grid ColumnDefinitions="110,80,80,*"><TextBlock Text="{Binding Phase}"/><TextBlock Grid.Column="1" Text="{Binding A}"/><TextBlock Grid.Column="2" Text="{Binding B}"/><TextBlock Grid.Column="3" Text="{Binding Delta}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
        <TabItem Header="알람"><ScrollViewer><ItemsControl ItemsSource="{Binding Alarms}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="c:Alarm"><Border BorderBrush="#455C70" BorderThickness="0,0,0,1" Padding="4"><StackPanel><TextBlock Text="{Binding Code}" FontWeight="Bold"/><TextBlock Text="{Binding Module}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding SetAt}"/><Button Content="Ack" Command="{Binding $parent[Window].DataContext.AckCommand}" CommandParameter="{Binding Id}" IsEnabled="{Binding !Acked}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
        <TabItem Header="장치"><ItemsControl ItemsSource="{Binding Modules}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="c:ModuleStatus"><Grid ColumnDefinitions="90,85,*" Margin="0,4"><TextBlock Text="{Binding Module}"/><TextBlock Grid.Column="1" Text="{Binding State}"/><TextBlock Grid.Column="2" Text="{Binding Detail}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></TabItem>
      </TabControl></Border>
    </Grid>
  </Grid>
</Window>
