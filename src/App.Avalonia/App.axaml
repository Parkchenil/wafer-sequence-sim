<Application xmlns="https://github.com/avaloniaui"
             xmlns:local="using:App.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="App.Avalonia.App"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <local:DurationTextConverter x:Key="DurationText"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#100E16"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#211D2A"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF812C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F2F7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A49CAD"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#514956"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window"><Setter Property="FontFamily" Value="Arial, Apple SD Gothic Neo"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
        <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="9,5"/><Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HairlineBrush}"/></Style>
        <Style Selector="TabItem"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="9,10"/></Style>
        <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="0"/></Style>
        <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/></Style>
    </Application.Styles>
</Application>